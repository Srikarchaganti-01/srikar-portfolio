# Web3Forms access key for the contact form.
# Get a free key at https://web3forms.com, copy this file to `.env`, paste the key below.
# Vite exposes VITE_* variables to the browser bundle, so this key is public by design:
# restrict it to your domain in the Web3Forms dashboard. `.env` is git-ignored.
VITE_WEB3FORMS_KEY=

# Optional: your public site URL (no trailing slash), used for canonical/Open Graph
# tags, sitemap.xml and robots.txt. On Vercel this is detected automatically.
# VITE_SITE_URL=https://your-domain.com
